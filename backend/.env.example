# PAYONE Server-to-Server + Hosted Tokenization Page credentials (Global Online Platform / developer.payone.com)
# Get these from Merchant Portal (portal.preprod.payone.com) → Developer → Payment API.
# All three values are used server-side only (HMAC-signed) — never sent to the frontend.
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

PAYONE_API_KEY_ID=your_api_key_id_here
PAYONE_API_SECRET=your_api_secret_here
PAYONE_MERCHANT_ID=your_pspid_here

PORT=3000
